{
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "fields", "ai_inferences"],
  "properties": {
    "contract_version": { "type": "string", "const": "onboarding_direction_draft.v1" },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand",
        "business_context",
        "audience",
        "how_it_should_feel",
        "what_to_avoid",
        "visual_style_leaning",
        "main_direction"
      ],
      "properties": {
        "brand": { "$ref": "#/$defs/summary_field" },
        "business_context": { "$ref": "#/$defs/summary_field" },
        "audience": { "$ref": "#/$defs/summary_field" },
        "how_it_should_feel": { "$ref": "#/$defs/summary_field" },
        "what_to_avoid": { "$ref": "#/$defs/summary_field" },
        "visual_style_leaning": { "$ref": "#/$defs/summary_field" },
        "main_direction": { "$ref": "#/$defs/summary_field" }
      }
    },
    "ai_inferences": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/ai_inference" }
    }
  },
  "$defs": {
    "summary_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source", "inference_id", "confidence"],
      "properties": {
        "value": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"], "enum": ["user", "ai_inferred", null] },
        "inference_id": { "type": ["string", "null"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "ai_inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "field", "value", "confidence", "status"],
      "properties": {
        "id": { "type": "string" },
        "field": { "type": "string" },
        "value": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "type": "string", "const": "active" }
      }
    }
  }
}
