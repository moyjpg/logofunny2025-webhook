{
  "type": "object",
  "additionalProperties": false,
  "required": ["assistant_message", "ready_to_review", "readiness", "research", "questions"],
  "properties": {
    "assistant_message": { "type": "string" },
    "ready_to_review": { "type": "boolean" },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["business", "audience", "differentiation", "personality", "logo_context"],
      "properties": {
        "business": { "$ref": "#/$defs/readiness_field" },
        "audience": { "$ref": "#/$defs/readiness_field" },
        "differentiation": { "$ref": "#/$defs/readiness_field" },
        "personality": { "$ref": "#/$defs/readiness_field" },
        "logo_context": { "$ref": "#/$defs/readiness_field" }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offered", "reason", "confirmation_question"],
      "properties": {
        "offered": { "type": "boolean" },
        "reason": { "type": "string" },
        "confirmation_question": { "type": "string" }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "reason", "target_field"],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "reason": { "type": "string" },
          "target_field": {
            "enum": ["audience", "existing_visual_idea", "things_to_avoid", "rough_feeling", "visual_foundation", "other"]
          }
        }
      }
    }
  },
  "$defs": {
    "readiness_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["covered", "intentionally_open", "missing"] },
        "evidence": { "type": "string" }
      }
    }
  }
}
